    {
      "id": "P01-D",
      "layout": "custom",
      "component": "E_Steps",
      "label": "Task And Steps",
      "props": {
        "id": "P01-D",
        "kicker": "Load Balancer Build",
        "title": "Task And Steps",
        "steps": [
          {
            "text": "Verify the VPC, subnets, and route table against the table above before creating anything new",
            "icon": "ListChecks"
          },
          {
            "text": "Add one new subnet in a second zone, plus a load balancer security group and a web server security group",
            "icon": "SquarePlus"
          },
          {
            "text": "Launch two EC2 web servers, one per public subnet, each running a startup script",
            "icon": "Server"
          },
          {
            "text": "Create a target group and register both web servers as its targets",
            "icon": "Target"
          },
          {
            "text": "Create an internet-facing Application Load Balancer spanning both subnets, forwarding to the target group",
            "icon": "Split"
          },
          {
            "text": "Test the load balancer, then stop and restart a server to observe health checks",
            "icon": "Activity"
          },
          {
            "text": "Verify every component, capture screenshots, and delete resources in order: load balancer, target group, EC2 instances, `s6-web-sg`, `s6-alb-sg`, then `s6-public-subnet-2`",
            "icon": "Trash2"
          }
        ]
      },
      "notes": "1. Verify the Session 5 VPC, subnets, and route table against the table above before creating anything new."
    },
