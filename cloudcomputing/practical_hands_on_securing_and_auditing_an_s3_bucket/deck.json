    {
      "id": "P24",
      "layout": "table",
      "kicker": "HTTPS-Only Access",
      "title": "Deny Insecure Transport",
      "lead": "A bucket policy named DenyInsecureTransport rejects any request made without TLS, the secure transport protocol; it only blocks insecure requests and never grants access by itself",
      "table": {
        "type": "table",
        "size": 17,
        "columns": [
          {
            "label": "Policy Element",
            "icon": "i3d:policy",
            "weight": 1.25
          },
          {
            "label": "Meaning",
            "icon": "i3d:search",
            "weight": 1
          }
        ],
        "rows": [
          {
            "icon": "i3d:ban",
            "cells": [
              "`Effect: Deny`",
              "Rejects requests matching the statement"
            ]
          },
          {
            "icon": "i3d:users",
            "cells": [
              "`Principal: *`",
              "Applies to all principals"
            ]
          },
          {
            "icon": "i3d:asterisk",
            "cells": [
              "`Action: s3:*`",
              "Covers S3 actions"
            ]
          },
          {
            "icon": "i3d:bucket",
            "cells": [
              "`Resource: arn:aws:s3:::s17-security-lab-unique123` and `arn:aws:s3:::s17-security-lab-unique123/*`",
              "Covers the bucket and every object in it"
            ]
          },
          {
            "icon": "i3d:lock",
            "cells": [
              "`aws:SecureTransport: false`",
              "Matches requests without secure transport"
            ]
          }
        ]
      },
      "notes": "Practical part 3: attach the DenyInsecureTransport bucket policy."
    },
