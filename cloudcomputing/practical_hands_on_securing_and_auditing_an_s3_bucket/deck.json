    {
      "id": "P22",
      "layout": "lead",
      "kicker": "The Practical Task",
      "title": "What Gets Built",
      "lead": "This practical builds one S3 bucket and applies hygiene, encryption, access and audit controls across its full lifecycle, part by part",
      "figure": {
        "type": "custom",
        "name": "E_P22",
        "props": {
          "steps": 7,
          "items": [
            "Create a bucket with SSE-S3 default encryption",
            "Upload a file and verify it inherited encryption",
            "Attach a policy denying any non-HTTPS request",
            "Check Object Ownership (Bucket owner enforced, ACLs disabled) and Block Public Access settings",
            "Run a security audit against a fixed checklist",
            "Rescan every setting to confirm the secure end state",
            "Review CloudTrail events, then clean up the demo resources"
          ]
        }
      },
      "figW": 1100,
      "figH": 344
