{
  "compilerOptions": {
    "target": "ES2019",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleDetection": "auto",
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "gen",
    "newLine": "lf"
  },
  "include": ["src"]
}
